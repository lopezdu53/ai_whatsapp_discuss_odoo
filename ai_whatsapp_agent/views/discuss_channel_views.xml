<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hereda la vista form del canal de Discuss para añadir pestaña IA -->
    <record id="view_discuss_channel_form_ai_agent" model="ir.ui.view">
        <field name="name">discuss.channel.form.ai.agent</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="discuss.view_discuss_channel_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Agente IA" name="ai_agent_page"
                      attrs="{'invisible': [('channel_type', '!=', 'whatsapp')]}">
                    <group>
                        <group string="Estado del agente">
                            <field name="ai_agent_enabled" widget="boolean_toggle"/>
                            <field name="ai_agent_active" readonly="1"
                                   attrs="{'invisible': [('ai_agent_enabled', '=', False)]}"/>
                            <field name="ai_agent_paused_by" readonly="1"
                                   attrs="{'invisible': [('ai_agent_paused_by', '=', False)]}"/>
                            <field name="ai_agent_paused_at" readonly="1"
                                   attrs="{'invisible': [('ai_agent_paused_at', '=', False)]}"/>
                            <field name="last_human_message_at" readonly="1"
                                   attrs="{'invisible': [('last_human_message_at', '=', False)]}"/>
                        </group>
                        <group string="Configuración">
                            <field name="human_inactivity_timeout"/>
                            <field name="ai_system_prompt" widget="text"
                                   placeholder="Deja vacío para usar el prompt global de los ajustes"/>
                        </group>
                    </group>

                    <!-- Botones de acción -->
                    <div class="o_row mt-3"
                         attrs="{'invisible': [('ai_agent_enabled', '=', False)]}">
                        <button name="action_pause_ai_agent"
                                string="Pausar IA (atender humano)"
                                type="object"
                                class="btn btn-warning"
                                attrs="{'invisible': [('ai_agent_active', '=', False)]}"/>
                        <button name="action_resume_ai_agent"
                                string="Reactivar IA"
                                type="object"
                                class="btn btn-success"
                                attrs="{'invisible': [('ai_agent_active', '=', True)]}"/>
                    </div>
                    <div class="o_row mt-2"
                         attrs="{'invisible': [('ai_agent_enabled', '=', False)]}">
                        <button name="action_disable_ai_agent"
                                string="Deshabilitar agente IA"
                                type="object"
                                class="btn btn-danger btn-sm"/>
                    </div>
                    <div class="o_row mt-2"
                         attrs="{'invisible': [('ai_agent_enabled', '=', True)]}">
                        <button name="action_enable_ai_agent"
                                string="Habilitar agente IA"
                                type="object"
                                class="btn btn-primary"/>
                    </div>

                    <div class="alert alert-info mt-3"
                         attrs="{'invisible': [('ai_agent_enabled', '=', True)]}">
                        <p>
                            <strong>¿Cómo funciona el Agente IA?</strong><br/>
                            Al habilitar el agente IA, responderá automáticamente los mensajes entrantes
                            de WhatsApp. Los agentes humanos pueden pausarlo en cualquier momento.
                            Tras el tiempo de inactividad configurado, la IA se reactivará sola.
                        </p>
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Vista de lista para gestionar canales WhatsApp con IA -->
    <record id="view_whatsapp_channel_ai_list" model="ir.ui.view">
        <field name="name">discuss.channel.whatsapp.ai.list</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list string="Canales WhatsApp – Agente IA">
                <field name="name" string="Canal"/>
                <field name="ai_agent_enabled" string="IA habilitada" widget="boolean_toggle"/>
                <field name="ai_agent_active" string="IA activa"/>
                <field name="ai_agent_paused_by" string="Pausado por" optional="show"/>
                <field name="ai_agent_paused_at" string="Pausado en" optional="show"/>
                <field name="last_human_message_at" string="Último mensaje humano" optional="show"/>
                <field name="human_inactivity_timeout" string="Timeout (min)" optional="show"/>
                <button name="action_pause_ai_agent"
                        string="Pausar IA"
                        type="object"
                        icon="fa-pause"
                        attrs="{'invisible': [('ai_agent_active', '=', False)]}"/>
                <button name="action_resume_ai_agent"
                        string="Reactivar IA"
                        type="object"
                        icon="fa-play"
                        attrs="{'invisible': [('ai_agent_active', '=', True)]}"/>
            </list>
        </field>
    </record>

    <!-- Acción para abrir la lista de canales WhatsApp con IA -->
    <record id="action_whatsapp_ai_channels" model="ir.actions.act_window">
        <field name="name">Canales WhatsApp – Agente IA</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', '=', 'whatsapp')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_whatsapp_channel_ai_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('discuss.view_discuss_channel_form')})]"/>
        <field name="context">{'default_channel_type': 'whatsapp'}</field>
    </record>

    <!-- Ítem de menú bajo WhatsApp o Discuss -->
    <menuitem
        id="menu_whatsapp_ai_agent_root"
        name="Agente IA WhatsApp"
        parent="whatsapp.menu_whatsapp_root"
        sequence="90"/>

    <menuitem
        id="menu_whatsapp_ai_channels"
        name="Canales con Agente IA"
        parent="menu_whatsapp_ai_agent_root"
        action="action_whatsapp_ai_channels"
        sequence="10"/>

</odoo>
