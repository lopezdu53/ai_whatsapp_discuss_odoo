<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Vista de lista: canales WhatsApp con estado del agente IA
         ============================================================ -->
    <record id="view_whatsapp_channel_ai_list" model="ir.ui.view">
        <field name="name">discuss.channel.whatsapp.ai.list</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list string="Canales WhatsApp – Agente IA">
                <field name="name" string="Canal"/>
                <field name="ai_agent_enabled" string="IA habilitada" widget="boolean_toggle"/>
                <field name="ai_agent_active" string="IA activa"/>
                <field name="ai_agent_paused_by" string="Pausado por" optional="show"/>
                <field name="ai_agent_paused_at" string="Pausado en" optional="show"/>
                <field name="last_human_message_at" string="Últ. msg humano" optional="show"/>
                <field name="human_inactivity_timeout" string="Timeout (min)" optional="show"/>
                <button name="action_pause_ai_agent"
                        string="Pausar IA"
                        type="object"
                        icon="fa-pause"
                        invisible="not ai_agent_active"/>
                <button name="action_resume_ai_agent"
                        string="Reactivar IA"
                        type="object"
                        icon="fa-play"
                        invisible="ai_agent_active"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Vista de formulario standalone (sin heredar de ningún view)
         ============================================================ -->
    <record id="view_whatsapp_channel_ai_form" model="ir.ui.view">
        <field name="name">discuss.channel.whatsapp.ai.form</field>
        <field name="model">discuss.channel</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Agente IA – Canal WhatsApp">
                <header>
                    <button name="action_enable_ai_agent"
                            string="Habilitar Agente IA"
                            type="object"
                            class="btn-primary"
                            invisible="ai_agent_enabled"/>
                    <button name="action_pause_ai_agent"
                            string="⏸  Pausar IA (atender yo)"
                            type="object"
                            class="btn-warning"
                            invisible="not ai_agent_enabled or not ai_agent_active"/>
                    <button name="action_resume_ai_agent"
                            string="▶  Reactivar IA"
                            type="object"
                            class="btn-success"
                            invisible="not ai_agent_enabled or ai_agent_active"/>
                    <button name="action_disable_ai_agent"
                            string="Deshabilitar IA"
                            type="object"
                            class="btn-danger"
                            invisible="not ai_agent_enabled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Estado del agente">
                            <field name="ai_agent_enabled" widget="boolean_toggle"/>
                            <field name="ai_agent_active" readonly="1"
                                   invisible="not ai_agent_enabled"/>
                            <field name="ai_agent_paused_by" readonly="1"
                                   invisible="not ai_agent_paused_by"/>
                            <field name="ai_agent_paused_at" readonly="1"
                                   invisible="not ai_agent_paused_at"/>
                            <field name="last_human_message_at" readonly="1"
                                   invisible="not last_human_message_at"/>
                        </group>
                        <group string="Configuración de reactivación">
                            <field name="human_inactivity_timeout"
                                   help="0 = usar el valor global de Ajustes"/>
                        </group>
                    </group>

                    <group string="Prompt personalizado para este canal">
                        <field name="ai_system_prompt"
                               widget="text"
                               nolabel="1"
                               placeholder="Deja vacío para usar el prompt global configurado en Ajustes."/>
                    </group>

                    <div class="alert alert-info" invisible="ai_agent_enabled">
                        <strong>Agente IA deshabilitado.</strong>
                        Pulsa <em>Habilitar Agente IA</em> para que la IA
                        responda automáticamente los mensajes entrantes de WhatsApp en este canal.
                    </div>
                    <div class="alert alert-success" invisible="not ai_agent_enabled or not ai_agent_active">
                        ✅ <strong>Agente IA activo.</strong>
                        Respondiendo automáticamente. Pulsa <em>Pausar IA</em> para tomar el control.
                    </div>
                    <div class="alert alert-warning" invisible="not ai_agent_enabled or ai_agent_active">
                        ⏸ <strong>Agente IA pausado.</strong>
                        Un agente humano está atendiendo la conversación.
                        Se reactivará automáticamente tras el tiempo de inactividad configurado.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Acción para abrir canales WhatsApp con configuración IA
         ============================================================ -->
    <record id="action_whatsapp_ai_channels" model="ir.actions.act_window">
        <field name="name">Canales WhatsApp – Agente IA</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', '=', 'whatsapp')]</field>
        <field name="context">{'default_channel_type': 'whatsapp'}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_whatsapp_channel_ai_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_whatsapp_channel_ai_form')}),
        ]"/>
    </record>

    <!-- ============================================================
         Menú bajo Settings > Técnico (base.menu_administration
         existe en todas las instalaciones de Odoo)
         ============================================================ -->
    <menuitem
        id="menu_ai_whatsapp_agent_root"
        name="Agente IA WhatsApp"
        parent="base.menu_administration"
        sequence="50"
        groups="base.group_system"/>

    <menuitem
        id="menu_ai_whatsapp_channels"
        name="Canales WhatsApp"
        parent="menu_ai_whatsapp_agent_root"
        action="action_whatsapp_ai_channels"
        sequence="10"/>

</odoo>
