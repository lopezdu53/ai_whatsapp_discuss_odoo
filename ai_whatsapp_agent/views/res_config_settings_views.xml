<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción standalone para la configuración del Agente IA WhatsApp -->
    <record id="action_ai_whatsapp_config" model="ir.actions.act_window">
        <field name="name">Configuración Agente IA WhatsApp</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Vista de configuración standalone (sin heredar de base_setup) -->
    <record id="view_ai_whatsapp_config_form" model="ir.ui.view">
        <field name="name">ai.whatsapp.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Configuración – Agente IA WhatsApp" class="oe_form_configuration">
                <header>
                    <button string="Guardar" type="object" name="execute"
                            class="btn-primary"/>
                    <button string="Descartar" type="object" name="cancel"
                            class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <h2>Agente IA para WhatsApp</h2>
                    <p class="text-muted">
                        Configura el proveedor de inteligencia artificial que responderá
                        los mensajes de WhatsApp automáticamente.
                    </p>

                    <group string="Proveedor de IA">
                        <field name="ai_whatsapp_provider" widget="radio"/>
                        <field name="ai_whatsapp_api_key"
                               password="True"
                               placeholder="OpenAI: sk-...   |   Anthropic: sk-ant-..."/>
                        <field name="ai_whatsapp_model"
                               placeholder="OpenAI: gpt-4o   |   Anthropic: claude-sonnet-4-6"/>
                    </group>

                    <group string="Parámetros de generación">
                        <field name="ai_whatsapp_max_tokens"/>
                        <field name="ai_whatsapp_temperature"/>
                    </group>

                    <group string="Comportamiento">
                        <field name="ai_whatsapp_default_timeout"
                               help="Minutos sin respuesta del agente humano para reactivar la IA. 0 = desactivar reactivación automática."/>
                    </group>

                    <group string="Prompt del sistema (global)">
                        <field name="ai_whatsapp_default_system_prompt"
                               widget="text"
                               nolabel="1"
                               style="min-height:120px"
                               placeholder="Eres un asistente de atención al cliente amable y conciso. Responde siempre en el idioma del cliente."/>
                    </group>

                    <div class="alert alert-info">
                        <strong>Modelos recomendados:</strong><br/>
                        • OpenAI: <code>gpt-4o</code>, <code>gpt-4o-mini</code><br/>
                        • Anthropic: <code>claude-sonnet-4-6</code>, <code>claude-haiku-4-5-20251001</code>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actualizar la acción para usar nuestra vista -->
    <record id="action_ai_whatsapp_config" model="ir.actions.act_window">
        <field name="name">Configuración Agente IA WhatsApp</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="view_id" ref="view_ai_whatsapp_config_form"/>
    </record>

    <!-- Menú de Configuración bajo Ajustes > Técnico -->
    <menuitem
        id="menu_ai_whatsapp_config"
        name="Configuración IA"
        parent="menu_ai_whatsapp_agent_root"
        action="action_ai_whatsapp_config"
        sequence="20"
        groups="base.group_system"/>

</odoo>
