<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_ai_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.ai.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Agente IA WhatsApp"
                     data-key="ai_whatsapp_agent" string="Agente IA WhatsApp">

                    <h2>Agente IA para WhatsApp</h2>

                    <div class="row mt-4">
                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Proveedor de IA</span>
                                    <div class="text-muted">
                                        Selecciona el proveedor de inteligencia artificial que procesará las conversaciones.
                                    </div>
                                    <div class="content-group mt-2">
                                        <div class="row">
                                            <div class="col-12">
                                                <field name="ai_whatsapp_provider" widget="radio"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">API Key</span>
                                    <div class="text-muted">
                                        Clave secreta de OpenAI o Anthropic. Se guarda cifrada.
                                    </div>
                                    <div class="content-group mt-2">
                                        <field name="ai_whatsapp_api_key"
                                               password="True"
                                               placeholder="sk-... / sk-ant-..."/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Modelo de IA</span>
                                    <div class="text-muted">
                                        OpenAI: <code>gpt-4o</code>, <code>gpt-4-turbo</code> |
                                        Anthropic: <code>claude-sonnet-4-6</code>, <code>claude-opus-4-7</code>
                                    </div>
                                    <div class="content-group mt-2">
                                        <field name="ai_whatsapp_model" placeholder="gpt-4o"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Inactividad humana (minutos)</span>
                                    <div class="text-muted">
                                        Tiempo sin respuesta del agente humano para reactivar la IA automáticamente.
                                        0 = no reactivar.
                                    </div>
                                    <div class="content-group mt-2">
                                        <field name="ai_whatsapp_default_timeout"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Tokens máximos</span>
                                    <div class="text-muted">
                                        Longitud máxima de cada respuesta generada (tokens ≈ palabras).
                                    </div>
                                    <div class="content-group mt-2">
                                        <field name="ai_whatsapp_max_tokens"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Temperatura (0.0 – 1.0)</span>
                                    <div class="text-muted">
                                        0.0 = respuestas exactas y deterministas. 1.0 = mayor creatividad.
                                    </div>
                                    <div class="content-group mt-2">
                                        <field name="ai_whatsapp_temperature"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Prompt del sistema (global)</span>
                                    <div class="text-muted">
                                        Instrucciones base para la IA. Cada canal puede sobreescribirlo.
                                    </div>
                                    <div class="content-group mt-2">
                                        <field name="ai_whatsapp_default_system_prompt"
                                               widget="text"
                                               style="min-height: 100px;"
                                               placeholder="Eres un asistente de atención al cliente amable y conciso..."/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>

</odoo>
