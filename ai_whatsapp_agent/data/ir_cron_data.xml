<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_resume_ai_after_inactivity" model="ir.cron">
            <field name="name">Agente IA WhatsApp: Reactivar por inactividad humana</field>
            <field name="model_id" model="ir.model" search="[('model', '=', 'discuss.channel')]"/>
            <field name="state">code</field>
            <field name="code">model._cron_resume_ai_after_inactivity()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
